# Permanent domain reported live by the owner.
# This origin alone does not enable indexing. No path/query/hash.
SITE_URL=https://abrillatallada.uy

# Opt in only after professional content and contact information are confirmed.
# Indexing also requires NODE_ENV=production and VERCEL_ENV=production.
SEO_INDEXABLE=false

# Business WhatsApp in international format: country code + number, without a local 0.
# Leave empty until the confirmed business number is available.
WHATSAPP_NUMBER=

# Brevo server-side API key. Create a Restricted key with Transactional emails: All.
# Set its real value in Vercel Environment Variables or an ignored .env.local file.
# This is an API key, not an SMTP key. Never use the NEXT_PUBLIC_ prefix.
BREVO_API_KEY=

# Authenticate abrillatallada.uy in Brevo, then add this sender before sending.
# Suggested sender; domain authentication is still required.
BREVO_SENDER_EMAIL=consultas@abrillatallada.uy
BREVO_SENDER_NAME="Abril Latallada D’Elias"

# Fixed recipient for the website consultation form. Never taken from browser input.
CONSULTATION_TO_EMAIL=dra.latallada@gmail.com
